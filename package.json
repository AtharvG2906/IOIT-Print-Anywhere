{
  "name": "ioit-print-anywhere",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:dev": "prisma dev --name print-anywhere --detach",
    "db:migrate": "prisma migrate dev",
