# ---- Core ----
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Shadow database used by `prisma migrate dev` (local prisma dev only).
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# Local `prisma dev` database supports one connection. Remove in production.
DATABASE_POOL_MAX="1"
APP_URL="http://localhost:3000"
# Long random string (openssl rand -hex 32). Used to hash OTPs and session tokens.
SESSION_SECRET=""
# Comma-separated emails that get the admin/desk dashboard.
ADMIN_EMAILS="desk@example.com"

# ---- Razorpay ----
# Leave keys empty in development to use the built-in "Simulate payment" button.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- Email (OTP codes, welcome, payment received, prints ready) ----  console | resend
# Resend needs a verified sending domain to email students. Without one it only delivers
# to your own Resend account address (from onboarding@resend.dev).
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="IOIT Print Anywhere <prints@example.com>"

# ---- File storage ----  local | s3   (s3 works with Cloudflare R2)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Print agent & maintenance ----
# Shared secret the Windows print agent sends as "Authorization: Bearer <key>".
AGENT_API_KEY=""
# Secret for GET /api/cron/maintenance (optional; the agent heartbeat also runs maintenance).
CRON_SECRET=""
